# Copy to .env and fill local secret values.
# Never commit .env.

DB_URL=jdbc:postgresql://localhost:5434/rippleguard_governance
DB_USERNAME=rippleguard_governance
DB_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CONSUMER_GROUP=rippleguard-governance-service

GOVERNANCE_KAFKA_ENABLED=true
TOPIC_LOAN_APPLICATION_SUBMITTED=loan.application.submitted.v1

OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_SECONDS=60
OUTBOX_INSTANCE_ID=governance-service-local

CONTRACTS_ROOT=../rippleguard-contracts

AGENT_RUNTIME_ENABLED=true
AGENT_RUNTIME_BASE_URL=
AGENT_RUNTIME_LOAN_DECISION_RUNS_PATH=/internal/v1/loan-decision-agent/runs
AGENT_RUNTIME_CONNECT_TIMEOUT=2s
AGENT_RUNTIME_RESPONSE_TIMEOUT=10s
AGENT_RUNTIME_MAX_ATTEMPTS=2
AGENT_RUNTIME_REQUEST_TIMEOUT=30s
AGENT_RUNTIME_RETRY_BACKOFF=2s
AGENT_RUNTIME_LEASE_DURATION=30s
AGENT_RUNTIME_RECOVERY_DELAY_MS=5000
AGENT_RUNTIME_MAX_RESPONSE_BYTES=1048576

PHASE2_EXECUTION_PLAN_VERSION=phase2-loan-agent.v1
PHASE2_FEATURE_SCHEMA_VERSION=phase-2-loan-features.v1.0.0
PHASE2_PREPROCESSING_VERSION=preprocess.v1.0.0
PHASE2_MODEL_VERSION=loan-model.v1.0.0
PHASE2_MODEL_ARTIFACT_DIGEST=
PHASE2_THRESHOLD_VERSION=threshold.v1.0.0
